{
  "version": 2,
  "project": "operations/oncall",
  "runtime": {
    "requirements": [
      {
        "name": "node",
        "version": "22.20.0"
      },
      {
        "name": "pnpm",
        "version": "10.12.4"
      }
    ]
  },
  "requiredEnvironment": [],
  "seedContract": {
    "version": 1,
    "profile": "first-party",
    "adapter": "scripts/installer/local.mjs"
  },
  "documentation": {
    "document": "RUN-LOCALLY.md"
  },
  "commands": {
    "setup": {
      "argv": [
        "rer",
        "setup"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Build and migrate local state, save the first owner and private settings, and retain existing owner, secrets and data on repeat setup. No provider request."
    },
    "dev": {
      "argv": [
        "rer",
        "dev"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Run Oncall on a loopback address, applying local migrations and opening a private owner sign-in link. Email remains in the local outbox; --as signed-out uses ordinary sign-in; --stop stops the owned server."
    },
    "build": {
      "argv": [
        "rer",
        "build"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for build effects."
    },
    "verify": {
      "argv": [
        "rer",
        "verify"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for verify effects."
    },
    "reset": {
      "argv": [
        "rer",
        "reset"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for reset effects."
    },
    "deploy": {
      "argv": [
        "rer",
        "deploy"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Application deployment is held: rer deploy refuses before any provider request until an independent standby and approved hosted release exist. Paging also requires a real-phone drill. --site publishes the separate Run site with provider credentials. --dry-run builds and validates the selected app or site locally without provider requests."
    },
    "export": {
      "argv": [
        "rer",
        "export"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Write a private local archive of supported durable records and import journal; exclude sessions, credentials and private settings. Stop dev and preview first."
    },
    "import": {
      "argv": [
        "rer",
        "import"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Require an empty local destination and explicit --yes; atomically restore validated records and journal, pause pending timers and hold handoff approvals. Credentials and sessions never transfer; new owners must explicitly map an archived administrator identity."
    },
    "release": {
      "argv": [
        "rer",
        "release"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for release effects."
    },
    "outbox": {
      "argv": [
        "rer",
        "outbox"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for outbox effects."
    },
    "doctor": {
      "argv": [
        "rer",
        "doctor"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for doctor effects."
    },
    "describe": {
      "argv": [
        "rer",
        "describe"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for describe effects."
    },
    "check": {
      "argv": [
        "rer",
        "check"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for check effects."
    },
    "install": {
      "argv": [
        "rer",
        "install"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "See SEED-COMMAND-CONTRACT.md for install effects."
    },
    "preview": {
      "argv": [
        "rer",
        "preview"
      ],
      "inputs": [
        "package.json",
        "scripts/installer/local.mjs"
      ],
      "effects": "Serve the built Oncall app on a loopback address with local state and owner sign-in. Email remains in the local outbox; --stop stops the owned server."
    }
  },
  "health": {
    "path": "/health",
    "meaning": "The actual local Worker is serving."
  },
  "acceptance": {
    "document": "ACCEPTANCE.md"
  },
  "environmentSources": {},
  "configuration": {
    "module": "scripts/operations-config.mjs"
  }
}
