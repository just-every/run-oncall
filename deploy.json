{
  "version": 1,
  "project": "operations/oncall",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "optional": true
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    },
    {
      "binding": "SENDGRID_API_KEY",
      "environment": "SENDGRID_API_KEY",
      "optional": true
    },
    {
      "binding": "RESEND_API_KEY",
      "environment": "RESEND_API_KEY",
      "optional": true
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "optional": true
    },
    {
      "binding": "MAIL_RECIPIENTS",
      "environment": "MAIL_RECIPIENTS",
      "optional": true
    },
    {
      "binding": "INBOUND_EMAIL_DOMAIN",
      "environment": "INBOUND_EMAIL_DOMAIN",
      "optional": true
    },
    {
      "binding": "PAGERDUTY_OAUTH_CLIENT_ID",
      "environment": "PAGERDUTY_OAUTH_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "PAGERDUTY_OAUTH_CLIENT_SECRET",
      "environment": "PAGERDUTY_OAUTH_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "TWILIO_ACCOUNT_SID",
      "environment": "TWILIO_ACCOUNT_SID",
      "optional": true
    },
    {
      "binding": "TWILIO_AUTH_TOKEN",
      "environment": "TWILIO_AUTH_TOKEN",
      "optional": true
    },
    {
      "binding": "TWILIO_API_KEY_SID",
      "environment": "TWILIO_API_KEY_SID",
      "optional": true
    },
    {
      "binding": "TWILIO_API_KEY_SECRET",
      "environment": "TWILIO_API_KEY_SECRET",
      "optional": true
    },
    {
      "binding": "TWILIO_FROM_NUMBER",
      "environment": "TWILIO_FROM_NUMBER",
      "optional": true
    },
    {
      "binding": "TWILIO_TO_NUMBER",
      "environment": "TWILIO_TO_NUMBER",
      "optional": true
    }
  ],
  "crons": [
    "* * * * *"
  ]
}
