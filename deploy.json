{
  "version": 1,
  "project": "operations/oncall",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "sendgrid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "SENDGRID_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "auth@example.test"
    },
    {
      "binding": "INBOUND_EMAIL_DOMAIN",
      "environment": "INBOUND_EMAIL_DOMAIN",
      "optional": true
    },
    {
      "binding": "PAGERDUTY_OAUTH_CLIENT_ID",
      "environment": "PAGERDUTY_OAUTH_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "PAGERDUTY_OAUTH_CLIENT_SECRET",
      "environment": "PAGERDUTY_OAUTH_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "RER_BUSINESS_TRUST",
      "environment": "RER_BUSINESS_TRUST",
      "optional": true,
      "verifyStandIn": "{\"v\":1,\"issuer\":\"https://synthetic-hosted-business.invalid\",\"audience\":\"https://rer-hosted-check.invalid\",\"subject\":\"synthetic-hosted-installation\",\"keys\":{\"synthetic-hosted\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"axfR8uEsQkf4vOblY6RA8ncDfYEt6zOg9KE5RdiYwpY\",\"y\":\"T-NC4v4af5uO5-tKfA-eFivOM1drMV7Oy7ZAaDe_UfU\"}}}"
    }
  ],
  "crons": [
    "* * * * *"
  ]
}
