{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-oncall",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_FROM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oncall-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/core"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "OncallWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "oncall-workspace-v1",
      "new_sqlite_classes": [
        "OncallWorkspace"
      ]
    }
  ]
}
