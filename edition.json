{
  "schemaVersion": 1,
  "id": "just-every/run-oncall",
  "toolchain": {
    "id": "runeditrun/edition-authoring",
    "version": "1.1.0"
  },
  "components": [
    {
      "id": "runeditrun/base",
      "role": "foundation",
      "source": {
        "kind": "local",
        "paths": [
          "src/base"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "9f2de6639a906ce2742edd7a182319752e39c4d9",
          "path": "foundation/runtime"
        }
      }
    },
    {
      "id": "just-every/run-oncall",
      "role": "edition",
      "source": {
        "kind": "local",
        "paths": [
          "src/routes",
          "src/site",
          "src/landing",
          "src/docs",
          "public",
          "scripts",
          "package.json"
        ]
      }
    },
    {
      "id": "runeditrun/demo",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "src/modules/demo"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "9f2de6639a906ce2742edd7a182319752e39c4d9",
          "path": ".",
          "paths": [
            "modules/demo"
          ]
        },
        "mappings": [
          {
            "path": "src/modules/demo",
            "originPath": "modules/demo"
          }
        ]
      }
    }
  ]
}
