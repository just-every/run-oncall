    "verify:app": "node tests/verify.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "outbox": "rer outbox",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:flows": "node tests/activation.mjs",
    "test:browser": "node tests/activation-browser.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-router": "1.170.33",
