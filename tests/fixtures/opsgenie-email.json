{
  "integrations": {
    "data": [
      {
        "id": "synthetic-oncall-email-og",
        "type": "Email",
        "name": "Saved email monitor",
        "enabled": true
      }
    ]
  },
  "integration_actions": [
    {
      "data": {
        "_parent": {
          "id": "synthetic-oncall-email-og",
          "name": "Saved email monitor",
          "type": "Email",
          "enabled": true
        },
        "ignore": [],
        "create": [
          {
            "type": "create",
            "name": "Marked failure",
            "order": 2,
            "filter": {
              "conditionMatchType": "Match All Conditions",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Equals",
                  "expectedValue": "Marked failure"
                }
              ]
            },
            "alias": "{{message.substringBetween(\"[\",\"]\")}}"
          },
          {
            "type": "create",
            "name": "Database failure",
            "order": 1,
            "filter": {
              "conditionMatchType": "Match All Conditions",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Matches",
                  "expectedValue": "FAILED: (\\S+)"
                },
                {
                  "field": "from_address",
                  "isNot": false,
                  "operation": "Contains",
                  "expectedValue": "monitor"
                },
                {
                  "field": "message",
                  "isNot": true,
                  "operation": "Contains",
                  "expectedValue": "mute"
                }
              ]
            },
            "alias": "{{subject.extract(/FAILED: (\\S+)/)}}"
          },
          {
            "type": "create",
            "name": "Whole failure",
            "order": 3,
            "filter": {
              "conditionMatchType": "Match All Conditions",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Equals",
                  "expectedValue": "Whole failure"
                }
              ]
            },
            "alias": "{{message}}"
          }
        ],
        "close": [
          {
            "type": "close",
            "name": "Database recovery",
            "order": 1,
            "filter": {
              "conditionMatchType": "Match Any Condition",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Matches",
                  "expectedValue": "OK: (\\S+)"
                },
                {
                  "field": "message",
                  "isNot": false,
                  "operation": "Equals",
                  "expectedValue": "resolve-by-body"
                }
              ]
            },
            "alias": "{{subject.extract(/OK: (\\S+)/)}}"
          },
          {
            "type": "close",
            "name": "Marked recovery",
            "order": 2,
            "filter": {
              "conditionMatchType": "Match All Conditions",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Equals",
                  "expectedValue": "Marked recovery"
                }
              ]
            },
            "alias": "{{message.substringBetween(\"[\",\"]\")}}"
          },
          {
            "type": "close",
            "name": "Whole recovery",
            "order": 3,
            "filter": {
              "conditionMatchType": "Match All Conditions",
              "conditions": [
                {
                  "field": "subject",
                  "isNot": false,
                  "operation": "Equals",
                  "expectedValue": "Whole recovery"
                }
              ]
            },
            "alias": "{{message}}"
          }
        ],
        "acknowledge": [],
        "addNote": []
      }
    }
  ]
}
