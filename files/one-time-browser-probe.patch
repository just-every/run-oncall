+  const row=reopenedSnooze.getByRole('region',{name:'Incident deadlines'}).getByText(/^Snooze · Cancelled · due /)
+  await row.waitFor()
+  if(width===1440){
+   await expect(row).toHaveText('Snooze · Cancelled · due '+shownDue+' · '+cancelledDeadline58.outcome)
+   await expect(reopenedSnooze.getByRole('button',{name:'Cancel pending deadline',exact:true})).toHaveCount(0)
+   assert.ok(await reopened.page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth))
+  }
+  await row.scrollIntoViewIfNeeded()
+  await reopened.page.screenshot({path:captureDirectory+'/oc058-cancelled-snooze-'+width+'.png'})
+  await reopened.context.close()
+ }
+ assert.deepEqual(browserOutbound58,[],'no browser egress')
+ const workerOutbound58=await worker.outboundRequests()
+ assert.deepEqual(workerOutbound58,[],'no Worker egress')
+ assert.deepEqual(errors,[])
+ console.log('OC-058-RECEIPT '+JSON.stringify({
+  trigger:201,recovery:201,sweep:sweep58.status,anonymousState:401,browserClosedThroughSweep:true,
+  singleLinkedGeneration:true,state:after58.state,durationMinutes:cancelledDeadline58.minutes,
+  responder:recoveryResponder.name,startedAt:pendingDeadline58.createdAt,endedAt:cancelledDeadline58.endedAt,
+  dueAt:cancelledDeadline58.dueAt,deadlineState:cancelledDeadline58.state,reason:cancelledDeadline58.outcome,
+  obligation:cancelledDeadline58.obligation,timeline:{actor:cancelEntry58.actor,at:cancelEntry58.at,text:cancelEntry58.text},
+  deadlineFiredEntries:0,paging:priorPaging58.paging,pagingChanges:0,
+  workerOutbound:workerOutbound58.length,browserOutbound:browserOutbound58.length,assertedWidth:1440,capturedWidths:[1440,390],
+ }))
  }
 }
 }
