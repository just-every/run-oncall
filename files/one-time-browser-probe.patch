+  await deadlineTimeline.waitFor()
+  let shownDue
+  if(width===1440){
+   const protectedState=ok(await call(reopened.page,'/api/state'))
+   assert.deepEqual(protectedState.incidents.find(i=>i.id===linked58.id),after58)
+   shownDue=await reopened.page.evaluate(value=>{
+    const zone=Intl.DateTimeFormat().resolvedOptions().timeZone
+    const date=new Date(value)
+    const label=date.toLocaleString([], {timeZone:zone,month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'})
+    const offset=new Intl.DateTimeFormat('en-GB',{timeZone:zone,timeZoneName:'shortOffset'}).formatToParts(date)
+     .find(part=>part.type==='timeZoneName').value
+    return label+' '+zone+' ('+offset+')'
+   },cancelledDeadline58.dueAt)
+   await expect(stateBadge).toHaveText('Acknowledged')
+   await expect(deadlineTimeline.locator('p')).toHaveText(cancelEntry58.text.replace(dueAt58,shownDue))
+   await expect(deadlineTimeline.locator('small')).toHaveText('Deadline scheduler')
+   await expect(deadlineTimeline.locator('time')).toHaveAttribute('datetime',cancelEntry58.at)
+   await expect(reopened.page.getByRole('region',{name:'Timeline'}).getByText('Deadline reached',{exact:true})).toHaveCount(0)
+  }
+  await deadlineTimeline.scrollIntoViewIfNeeded()
